{
  "env": {
    "NODE_TLS_REJECT_UNAUTHORIZED": "0"
  },
  "model": "haiku",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "theme": "dark",
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  }
}
